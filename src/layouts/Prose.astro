---
import Base from './Base.astro';
interface Props { title: string; description: string; heading: string; updated?: string; noindex?: boolean }
const { title, description, heading, updated, noindex } = Astro.props;
---
<Base {title} {description} {noindex}>
  <section class="prose-hero on-dark">
    <div class="wrap">
      <h1 class="h2">{heading}</h1>
      {updated && <p>Last updated {updated}</p>}
    </div>
  </section>
  <article class="wrap prose">
    <slot />
  </article>
</Base>
<style>
  .prose-hero {
    background: var(--ah-ink);
    padding-block: 48px 40px;
    border-bottom: 6px solid transparent;
    border-image: var(--ah-gradient) 1;
  }
  .prose-hero p {
    margin-top: 8px;
    color: var(--muted-on-dark);
  }
  .prose {
    max-width: calc(760px + var(--gutter) * 2);
    padding-block: 40px 72px;
  }
  .prose :global(h2) {
    font-size: 1.375rem;
    margin: 32px 0 10px;
  }
  .prose :global(p),
  .prose :global(ul) {
    margin-bottom: 14px;
  }
  .prose :global(li) {
    margin-bottom: 6px;
  }
</style>
