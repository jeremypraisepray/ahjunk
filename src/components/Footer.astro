---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { business } from '../data/business';
import { services } from '../data/services';
import { primaryAreas } from '../data/areas';
const socials = Object.entries(business.socials).filter(([, url]) => url);
const year = new Date().getFullYear();
---
<footer class="site-footer on-dark">
  <div class="site-footer__band" aria-hidden="true">
    <svg class="skyline" viewBox="0 0 1200 80" preserveAspectRatio="none">
      <path d="M0 80V62h40v-8h22v8h30V40h18v-10h10v10h16v22h26V48h34v14h20V20h8V8h6v12h8v42h22V34h28v28h18V52h30v10h24V26h12V14h4v12h12v36h26V44h40v18h22V30h20v-12h6v12h18v32h30V50h26v12h40V36h18V22h10v14h14v26h28V46h36v16h22V28h16V10h8v18h14v34h24V52h32v10h30V38h22v24h40V48h28v14h26V32h18v-8h8v8h12v30h34V54h30v8h38V40h20v22h24V50h42v12h30V36h16v-6h10v6h12v26h40v18z" fill="rgb(255 255 255 / 0.12)"/>
    </svg>
  </div>
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      <Logo size={48} variant="dark" />
      <p class="tagline">{business.tagline} Same-day junk removal across Greater Houston, 7 days a week.</p>
      <address class="nap">
        <strong>{business.name}</strong><br />
        <a href={business.phone.tel} data-track="click_call" data-track-loc="footer">{business.phone.display}</a><br />
        <a href={`mailto:${business.email}`}>{business.email}</a><br />
        {business.hours.days}, {business.hours.label}<br />
        Serving {business.areaLabel}
      </address>
      {socials.length > 0 && (
        <ul class="socials">
          {socials.map(([name, url]) => <li><a href={url} rel="noopener" target="_blank">{name[0].toUpperCase() + name.slice(1)}</a></li>)}
        </ul>
      )}
    </div>
    <nav aria-label="Services">
      <h2 class="site-footer__h">Services</h2>
      <ul>{services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.title}</a></li>)}</ul>
    </nav>
    <nav aria-label="Service areas">
      <h2 class="site-footer__h">Areas</h2>
      <ul>{primaryAreas.map((a) => <li><a href={`/areas/${a.slug}/`}>{a.name}</a></li>)}</ul>
      <a class="more" href="/#areas">All Houston areas <Icon name="ArrowRight" size={16} class="" /></a>
    </nav>
  </div>
  <div class="wrap site-footer__legal">
    <p>© <span data-year>{year}</span> {business.name}. All rights reserved.</p>
    <ul>
      <li><a href="/privacy/">Privacy Policy</a></li>
      <li><a href="/terms/">Terms</a></li>
    </ul>
  </div>
</footer>
<style>
  .site-footer {
    background: var(--ah-ink);
    color: var(--muted-on-dark);
    font-size: 1rem;
  }
  .site-footer__band {
    height: 56px;
    background: var(--ah-gradient);
    position: relative;
    overflow: hidden;
  }
  .skyline {
    position: absolute;
    inset: auto 0 0 0;
    width: 100%;
    height: 56px;
  }
  .site-footer__grid {
    display: grid;
    gap: 36px;
    padding-block: 48px 32px;
  }
  .tagline {
    margin-block: 16px;
    max-width: 38ch;
  }
  .nap {
    font-style: normal;
    line-height: 1.8;
  }
  .nap strong {
    color: #fff;
  }
  .site-footer a {
    color: #fff;
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--orange-on-dark);
    text-decoration: underline;
  }
  .site-footer__h {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 1.25rem;
    color: #fff;
    margin-bottom: 12px;
  }
  .site-footer ul {
    list-style: none;
    padding: 0;
  }
  nav li a {
    display: inline-block;
    padding-block: 6px;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    font-weight: 700;
  }
  .socials {
    display: flex;
    gap: 16px;
    margin-top: 12px;
  }
  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding-block: 20px 28px;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: 0.9375rem;
  }
  .site-footer__legal ul {
    display: flex;
    gap: 20px;
  }
  @media (min-width: 768px) {
    .site-footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
  }
</style>
