---
import Icon from './Icon.astro';
import Stars from './Stars.astro';
import { business } from '../data/business';
const g = business.google;
const items = [
  { icon: 'ShieldCheck', text: 'Licensed & Insured' },
  { icon: 'House', text: 'Locally owned — not a franchise' },
  { icon: 'CalendarCheck', text: '7 days a week' },
  { icon: 'Recycle', text: 'Donate & recycle first' },
];
---
<section class="trust on-dark" aria-label="Why Houston trusts A&H">
  <ul class="wrap trust__list">
    <li class="trust__rating">
      <Stars rating={g.rating} label={`Rated ${g.rating.toFixed(1)} out of 5 on Google`} />
      <span><strong>{g.rating.toFixed(1)}</strong> on Google{g.reviewCount ? ` · ${g.reviewCount} reviews` : ''}</span>
    </li>
    {items.map((i) => <li><Icon name={i.icon as any} size={20} class="" />{i.text}</li>)}
  </ul>
</section>
<style>
  .trust {
    background: var(--ah-ink);
    border-bottom: 4px solid transparent;
    border-image: var(--ah-gradient) 1;
  }
  .trust__list {
    display: flex;
    gap: 28px;
    list-style: none;
    padding-block: 16px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent);
    mask-image: linear-gradient(90deg, #000 85%, transparent);
  }
  .trust__list::-webkit-scrollbar {
    display: none;
  }
  .trust__list li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    font-weight: 600;
    scroll-snap-align: start;
    flex: none;
  }
  .trust__list li :global(svg) {
    color: var(--orange-on-dark);
  }
  .trust__rating :global(.stars svg) {
    color: #f5b400;
  }
  @media (min-width: 1100px) {
    .trust__list {
      justify-content: space-between;
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
</style>
