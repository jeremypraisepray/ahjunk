---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-ah-junk-removal-1080.webp';
import { business } from '../data/business';
interface Props { size?: number; variant?: 'dark' | 'light'; href?: string }
const { size = 44, variant = 'light', href = '/' } = Astro.props;
---
<a class:list={['logo', `logo--${variant}`]} href={href} aria-label={`${business.name} — home`}>
  <Image src={logo} alt="" width={size} height={size} densities={[1, 2]} loading="eager" class="logo__mark" />
  <span class="logo__word" aria-hidden="true">
    <span class="logo__ah">A&amp;H</span>
    <span class="logo__sub">Junk Removal</span>
  </span>
</a>
<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: inherit;
  }
  .logo__mark {
    border-radius: 10px;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.15);
  }
  .logo__word {
    display: grid;
    line-height: 0.9;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 800;
    text-transform: uppercase;
  }
  .logo__ah {
    font-size: 1.6rem;
    letter-spacing: 0.01em;
  }
  .logo__sub {
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    color: var(--orange-text);
  }
  .logo--dark .logo__sub {
    color: var(--orange-on-dark);
  }
</style>
