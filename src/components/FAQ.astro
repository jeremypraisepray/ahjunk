---
import Icon from './Icon.astro';
interface Props { items: { q: string; a: string }[]; heading?: string; id?: string; schema?: boolean }
const { items, heading = 'Questions? Answered.', id = 'faq', schema = true } = Astro.props;
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<section class="section section--steel" id={id} aria-labelledby={`${id}-h`}>
  <div class="wrap faq">
    <div class="section-head">
      <span class="kicker"><span>FAQ</span></span>
      <h2 class="h2" id={`${id}-h`}>{heading}</h2>
      <span class="ribbon" aria-hidden="true"></span>
    </div>
    <div class="faq__list">
      {items.map((f, i) => (
        <details class="faq__item" open={i === 0}>
          <summary><h3>{f.q}</h3><Icon name="ChevronDown" class="faq__chev" /></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
</section>
<style>
  .faq {
    max-width: 880px;
  }
  .faq__list {
    display: grid;
    gap: 10px;
  }
  .faq__item {
    background: #fff;
    border-radius: var(--radius);
    border: 1px solid rgb(8 13 22 / 0.08);
  }
  .faq__item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    padding: 14px 18px;
    cursor: pointer;
    list-style: none;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item h3 {
    font-size: 1.0625rem;
    line-height: 1.3;
  }
  .faq__item :global(.faq__chev) {
    flex: none;
    color: var(--orange-text);
    transition: transform 0.2s;
  }
  .faq__item[open] :global(.faq__chev) {
    transform: rotate(180deg);
  }
  .faq__item p {
    padding: 0 18px 18px;
    color: var(--muted);
    max-width: 72ch;
  }
</style>
