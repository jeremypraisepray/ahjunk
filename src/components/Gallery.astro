---
import { Picture, getImage } from 'astro:assets';
import BeforeAfter from './BeforeAfter.astro';
import Icon from './Icon.astro';
import { gallery } from '../data/gallery';

const pairs = gallery.filter((g) => g.after);
const singles = await Promise.all(
  gallery.filter((g) => !g.after).map(async (g) => ({ ...g, full: (await getImage({ src: g.before, width: 1600, format: 'webp' })).src })),
);
---
<section class="section" id="gallery" aria-labelledby="gallery-h">
  <div class="wrap">
    <div class="section-head">
      <span class="kicker"><span>Proof</span></span>
      <h2 class="h2" id="gallery-h">Real Houston jobs</h2>
      <span class="ribbon" aria-hidden="true"></span>
      <p class="lead">Driveways, patios, garages and whole houses — this is what “before” looks like. We take it from here.</p>
    </div>

    {pairs.length > 0 && (
      <div class="ba-grid">
        {pairs.map((p) => <BeforeAfter before={p.before} after={p.after!} beforeAlt={p.alt} afterAlt={p.afterAlt ?? p.alt} caption={p.caption} />)}
      </div>
    )}

    <ul class="gal">
      {singles.map((g) => (
        <li class="gal__item" data-reveal>
          <button type="button" class="gal__btn" data-lightbox={g.full} data-alt={g.alt} data-caption={g.caption}>
            <Picture src={g.before} formats={['avif', 'webp']} fallbackFormat="webp" widths={[400, 640, 960]} sizes="(min-width: 900px) 400px, 50vw" alt={g.alt} loading="lazy" class="gal__img" />
            {g.tag && <span class:list={['gal__tag', g.tag === 'Before' && 'gal__tag--before']}>{g.tag}</span>}
            <span class="gal__zoom"><Icon name="Maximize2" size={18} class="" /><span class="sr-only">(enlarge photo)</span></span>
          </button>
          <p class="gal__cap">{g.caption}</p>
        </li>
      ))}
    </ul>
  </div>

  <dialog class="lightbox" data-lightbox-dialog aria-label="Photo viewer">
    <form method="dialog"><button class="lightbox__close" aria-label="Close photo"><Icon name="X" /></button></form>
    <img alt="" data-lightbox-img />
    <p data-lightbox-cap></p>
  </dialog>
</section>
<style>
  .ba-grid {
    display: grid;
    gap: 20px;
    margin-bottom: 24px;
  }
  @media (min-width: 640px) {
    .ba-grid {
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    }
  }
  .gal {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  @media (min-width: 900px) {
    .gal {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
  }
  .gal__btn {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--ah-steel);
    aspect-ratio: 4 / 3;
  }
  .gal__btn :global(picture) {
    display: block;
    height: 100%;
  }
  .gal :global(.gal__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .gal__btn:hover :global(.gal__img) {
    transform: scale(1.04);
  }
  .gal__tag {
    position: absolute;
    left: 10px;
    top: 10px;
    padding: 3px 10px;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #fff;
    background: var(--ah-ink);
    border-radius: 6px;
    transform: skewX(var(--skew));
  }
  .gal__tag--before {
    background: var(--btn);
  }
  .gal__zoom {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgb(8 13 22 / 0.65);
    color: #fff;
  }
  .gal__cap {
    margin-top: 6px;
    font-size: 0.9375rem;
    font-weight: 600;
    min-height: 26px;
  }
  .lightbox {
    max-width: min(1100px, 94vw);
    max-height: 92vh;
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--ah-ink);
    color: #fff;
    --focus: var(--blue-on-dark);
  }
  .lightbox::backdrop {
    background: rgb(8 13 22 / 0.85);
  }
  .lightbox img {
    max-height: 80vh;
    width: auto;
    margin-inline: auto;
  }
  .lightbox p {
    padding: 12px 16px 16px;
    font-weight: 600;
  }
  .lightbox__close {
    position: absolute;
    right: 10px;
    top: 10px;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: rgb(8 13 22 / 0.7);
    color: #fff;
  }
</style>
<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
  if (dlg && typeof dlg.showModal === 'function') {
    const img = dlg.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const cap = dlg.querySelector<HTMLElement>('[data-lightbox-cap]')!;
    document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((b) =>
      b.addEventListener('click', () => {
        img.src = b.dataset.lightbox!;
        img.alt = b.dataset.alt || '';
        cap.textContent = b.dataset.caption || '';
        dlg.showModal();
      }),
    );
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
  }
</script>
