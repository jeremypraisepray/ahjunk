---
/**
 * Multi-step quote form. Progressive enhancement:
 *  - No JS: all three steps render as one long form that posts to /api/quote.
 *  - JS: one step at a time, inline validation, photo resize, sessionStorage, fetch submit.
 */
import Icon from '../Icon.astro';
import TruckFill from '../TruckFill.astro';
import { business, loadSizes, timings, contactMethods } from '../../data/business';
import { quoteItems } from '../../data/services';
import { MAX_PHOTOS } from '../../lib/quote';

interface Props {
  /** Pre-checked item chip (service pages). */
  preselect?: string;
  title?: string;
}
const { preselect, title = 'Get your free quote in 60 seconds' } = Astro.props;
const smsHref = `${business.phone.sms}?&body=${encodeURIComponent(business.smsBody)}`;
---
<div class="quote-card" id="quote" data-quote-card tabindex="-1">
  <div class="quote-card__body" data-quote-body>
    <div class="quote-card__head">
      <h2 class="quote-card__title">{title}</h2>
      <p class="quote-card__micro">No obligation · We reply fast, 7 days a week</p>
    </div>

    <div class="progress js-only" aria-hidden="true">
      <ol class="progress__dots">
        <li class="is-active" data-dot="1"></li>
        <li data-dot="2"></li>
        <li data-dot="3"></li>
      </ol>
      <span class="progress__label">Step <span data-step-num>1</span> of 3</span>
    </div>
    <p class="sr-only" aria-live="polite" data-live></p>

    <form class="quote-form" method="post" action="/api/quote" enctype="multipart/form-data" data-quote-form>
      <!-- Step 1 -->
      <fieldset class="step is-active" data-step="1">
        <legend class="step__legend"><span class="step__n js-hide">1</span>What needs to go?</legend>
        <div class="chips chips--items" role="group" aria-describedby="err-items">
          {quoteItems.map((it) => (
            <label class="chip">
              <input type="checkbox" name="items" value={it.id} checked={preselect === it.id} />
              <span class="chip__face"><Icon name={it.icon as any} size={20} class="" />{it.label}</span>
            </label>
          ))}
        </div>
        <p class="field-error" id="err-items" data-error-for="items"></p>

        <div class="field field--zip">
          <label for="q-zip">ZIP code</label>
          <input id="q-zip" name="zip" type="text" inputmode="numeric" autocomplete="postal-code" maxlength="5" pattern="[0-9]{5}" required placeholder="e.g. 77019" aria-describedby="zip-msg err-zip" />
          <p class="zip-msg" id="zip-msg" aria-live="polite" data-zip-msg></p>
          <p class="field-error" id="err-zip" data-error-for="zip"></p>
        </div>

        <div class="step__nav js-only">
          <button type="button" class="btn btn--lg btn--block" data-next>Next <Icon name="ArrowRight" /></button>
        </div>
      </fieldset>

      <!-- Step 2 -->
      <fieldset class="step" data-step="2">
        <legend class="step__legend"><span class="step__n js-hide">2</span>How much &amp; when?</legend>
        <div class="size">
          <div class="size__truck" aria-hidden="true"><TruckFill id="form" fill={0} /></div>
          <div class="chips chips--size" role="radiogroup" aria-label="Load size" aria-describedby="err-size">
            {loadSizes.map((s) => (
              <label class="chip chip--sm">
                <input type="radio" name="size" value={s.id} data-fill={s.fill} required />
                <span class="chip__face">{s.label}</span>
              </label>
            ))}
          </div>
        </div>
        <p class="field-error" id="err-size" data-error-for="size"></p>

        <p class="group-label" id="when-label">When?</p>
        <div class="chips chips--when" role="radiogroup" aria-labelledby="when-label" aria-describedby="err-when">
          {timings.map((t) => (
            <label class="chip chip--sm">
              <input type="radio" name="when" value={t.id} required />
              <span class="chip__face">{t.label}</span>
            </label>
          ))}
        </div>
        <p class="field-error" id="err-when" data-error-for="when"></p>

        <div class="photos">
          <label class="photos__drop" for="q-photos">
            <Icon name="ImagePlus" />
            <span><strong>Add photos</strong> <span class="optional">(optional)</span><br /><span class="photos__hint">For a faster, more accurate price · up to {MAX_PHOTOS}</span></span>
          </label>
          <input class="photos__input" id="q-photos" name="photos" type="file" accept="image/*" multiple data-photos />
          <ul class="photos__list" data-photo-list></ul>
        </div>

        <div class="step__nav js-only">
          <button type="button" class="btn btn--ghost" data-back>Back</button>
          <button type="button" class="btn btn--lg" data-next>Next <Icon name="ArrowRight" /></button>
        </div>
      </fieldset>

      <!-- Step 3 -->
      <fieldset class="step" data-step="3">
        <legend class="step__legend"><span class="step__n js-hide">3</span>Where should we send your quote?</legend>
        <div class="grid-2">
          <div class="field">
            <label for="q-name">First name</label>
            <input id="q-name" name="firstName" type="text" autocomplete="given-name" maxlength="40" required aria-describedby="err-firstName" />
            <p class="field-error" id="err-firstName" data-error-for="firstName"></p>
          </div>
          <div class="field">
            <label for="q-phone">Mobile phone</label>
            <input id="q-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="16" required placeholder="(346) 555-0123" aria-describedby="err-phone" />
            <p class="field-error" id="err-phone" data-error-for="phone"></p>
          </div>
        </div>
        <div class="field">
          <label for="q-email">Email <span class="optional">(optional)</span></label>
          <input id="q-email" name="email" type="email" autocomplete="email" maxlength="120" aria-describedby="err-email" />
          <p class="field-error" id="err-email" data-error-for="email"></p>
        </div>
        <div class="field">
          <label for="q-address">Address or cross-streets <span class="optional">(optional)</span></label>
          <input id="q-address" name="address" type="text" autocomplete="street-address" maxlength="200" />
        </div>
        <div class="field">
          <label for="q-notes">Anything we should know? <span class="optional">(optional)</span></label>
          <textarea id="q-notes" name="notes" rows="2" maxlength="1500" placeholder="Stairs, gate code, items to keep…"></textarea>
        </div>

        <p class="group-label" id="contact-label">Best way to reach you</p>
        <div class="chips chips--contact" role="radiogroup" aria-labelledby="contact-label">
          {contactMethods.map((c, i) => (
            <label class="chip chip--sm">
              <input type="radio" name="contact" value={c.id} checked={i === 0} />
              <span class="chip__face">{c.label}</span>
            </label>
          ))}
        </div>

        <p class="consent" id="consent">
          By submitting, you agree to receive calls and texts from {business.name} about your quote. Msg frequency varies. Msg &amp; data rates may apply. Reply STOP to opt out, HELP for help. See our <a href="/privacy/" target="_blank">Privacy Policy</a>.
        </p>

        <!-- Spam traps + tracking -->
        <div class="hp" aria-hidden="true">
          <label for="q-website">Leave this empty</label>
          <input id="q-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="t" value="" data-t />
        <input type="hidden" name="page" value={Astro.url.pathname} data-page />
        <input type="hidden" name="utm_source" value="" />
        <input type="hidden" name="utm_medium" value="" />
        <input type="hidden" name="utm_campaign" value="" />
        <input type="hidden" name="gclid" value="" />

        <p class="form-error" role="alert" data-form-error></p>

        <div class="step__nav">
          <button type="button" class="btn btn--ghost js-only" data-back>Back</button>
          <button type="submit" class="btn btn--lg btn--submit" aria-describedby="consent" data-submit>
            <span data-submit-label>Get My Free Quote</span>
          </button>
        </div>
      </fieldset>
    </form>
  </div>

  <div class="quote-success" data-quote-success hidden tabindex="-1">
    <div class="quote-success__icon"><Icon name="CircleCheck" size={40} class="" /></div>
    <h2 class="quote-success__title">Got it<span data-success-name></span>!</h2>
    <p class="quote-success__msg" data-success-msg>We’ll text you within {business.responseMinutes} minutes during business hours.</p>
    <a class="btn btn--lg btn--block" href={business.phone.tel} data-track="click_call" data-track-loc="success"><Icon name="Phone" />Need it faster? Call {business.phone.display}</a>
    <a class="link-arrow" href={smsHref} data-track="click_text" data-track-loc="success"><Icon name="Camera" size={18} class="" />Add more photos by text</a>
  </div>
</div>

<style>
  .quote-card {
    position: relative;
    background: #fff;
    color: var(--ah-ink);
    border-radius: var(--radius-lg);
    border-top: 4px solid var(--ah-orange);
    box-shadow: var(--shadow-lg);
    --focus: var(--ah-blue);
    scroll-margin-top: calc(var(--header-h) + 12px);
  }
  .quote-card:focus {
    outline: none;
  }
  /* The card sits inside the dark hero — undo .on-dark inheritance */
  .quote-card :global(.btn--ghost) {
    --btn-bg: transparent;
    --btn-fg: var(--ah-ink);
    border-color: var(--line);
  }
  .quote-card :global(.btn--ghost:hover) {
    --btn-bg: var(--ah-steel);
  }
  .quote-card :global(a:not([class])) {
    color: var(--ah-blue);
  }
  .quote-card__body,
  .quote-success {
    padding: 18px 16px 18px;
  }
  @media (min-width: 768px) {
    .quote-card__body,
    .quote-success {
      padding: 22px 24px 24px;
    }
  }
  .quote-card__head {
    margin-bottom: 10px;
  }
  .quote-card__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-style: italic;
    text-transform: uppercase;
    font-size: clamp(1.45rem, 2.4vw, 1.75rem);
    line-height: 1;
  }
  .quote-card__micro {
    margin-top: 4px;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .progress {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--muted);
  }
  .progress__dots {
    display: flex;
    gap: 6px;
    list-style: none;
    padding: 0;
  }
  .progress__dots li {
    width: 28px;
    height: 6px;
    border-radius: 3px;
    background: var(--line);
    transform: skewX(var(--skew));
    transition: background-color 0.3s;
  }
  .progress__dots li.is-active,
  .progress__dots li.is-done {
    background: var(--ah-orange);
  }

  .step {
    border: 0;
    padding: 0;
    min-width: 0;
  }
  :global(.js) .step:not(.is-active) {
    display: none;
  }
  :global(.no-js) .step + .step {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .step__legend {
    padding: 0;
    margin-bottom: 10px;
    font-weight: 700;
    font-size: 1.125rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .step__n {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--ah-ink);
    color: #fff;
    font-size: 0.875rem;
  }
  :global(.js) .js-hide {
    display: none;
  }
  .step__nav {
    display: flex;
    gap: 10px;
    margin-top: 14px;
  }
  .step__nav .btn--lg {
    flex: 1;
  }

  /* Chips (checkbox/radio semantics, styled as buttons) */
  .chips {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  @media (min-width: 1024px) {
    .chips--items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .chips--when {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .chips--contact {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .chip {
    position: relative;
    display: block;
  }
  .chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }
  .chip__face {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 8px 10px;
    border: 1.5px solid var(--line);
    border-radius: 10px;
    background: #fff;
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.15;
    transition: border-color 0.15s, background-color 0.15s, transform 0.1s;
    pointer-events: none;
  }
  .chip__face :global(svg) {
    width: 20px;
    height: 20px;
    flex: none;
    color: var(--ah-blue);
  }
  .chip--sm .chip__face {
    justify-content: center;
    text-align: center;
    padding-inline: 6px;
  }
  .chip:hover .chip__face {
    border-color: #9aa3b2;
  }
  .chip input:active + .chip__face {
    transform: scale(0.97);
  }
  .chip input:checked + .chip__face {
    border-color: var(--ah-orange);
    background: #fff3eb;
    box-shadow: inset 0 0 0 1px var(--ah-orange);
  }
  .chip input:checked + .chip__face :global(svg) {
    color: var(--orange-text);
  }
  .chip input:focus-visible + .chip__face {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .size {
    display: grid;
    gap: 10px;
  }
  .size__truck {
    width: 150px;
    justify-self: center;
  }
  :global(.no-js) .size__truck {
    display: none;
  }
  .chips--size {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .chips--size .chip:last-child {
    grid-column: 1 / -1;
  }
  @media (min-width: 480px) {
    .chips--size {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .chips--size .chip {
      grid-column: span 2;
    }
    .chips--size .chip:nth-child(4),
    .chips--size .chip:nth-child(5) {
      grid-column: span 3;
    }
    .chips--size .chip:last-child {
      grid-column: span 3;
    }
  }

  .group-label {
    margin: 14px 0 8px;
    font-weight: 700;
  }
  .field {
    display: grid;
    gap: 4px;
    margin-top: 12px;
  }
  .field label {
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .optional {
    font-weight: 400;
    color: var(--muted);
  }
  .field input,
  .field textarea {
    width: 100%;
    min-height: 48px;
    padding: 10px 12px;
    border: 1.5px solid #9aa3b2;
    border-radius: 10px;
    background: #fff;
    font-size: 1.0625rem; /* ≥16px avoids iOS zoom */
  }
  .field textarea {
    min-height: 72px;
    resize: vertical;
  }
  .field input:focus,
  .field textarea:focus {
    border-color: var(--ah-blue);
    outline: 3px solid rgb(2 72 169 / 0.25);
    outline-offset: 0;
  }
  .field [aria-invalid='true'] {
    border-color: var(--error);
  }
  .field--zip {
    margin-top: 12px;
  }
  .field--zip input {
    max-width: 100%;
    letter-spacing: 0.08em;
    font-weight: 600;
  }
  .grid-2 {
    display: grid;
    gap: 0 12px;
  }
  @media (min-width: 480px) {
    .grid-2 {
      grid-template-columns: 1fr 1fr;
    }
  }
  .field-error,
  .form-error {
    color: var(--error);
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .field-error:empty,
  .form-error:empty,
  .zip-msg:empty {
    display: none;
  }
  .form-error {
    margin-top: 12px;
    padding: 10px 12px;
    border-radius: 8px;
    background: #fdecea;
  }
  .zip-msg {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--muted);
  }
  .zip-msg.is-ok {
    color: var(--ok);
  }

  .photos {
    margin-top: 14px;
  }
  .photos__drop {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    min-height: 56px;
    border: 1.5px dashed #9aa3b2;
    border-radius: 10px;
    cursor: pointer;
    line-height: 1.3;
  }
  .photos__drop:hover {
    border-color: var(--ah-blue);
    background: #f4f7fc;
  }
  .photos__drop :global(svg) {
    color: var(--ah-blue);
  }
  .photos__hint {
    font-size: 0.875rem;
    color: var(--muted);
  }
  :global(.js) .photos__input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .photos__input:focus-visible + .photos__list,
  .photos:focus-within .photos__drop {
    border-color: var(--ah-blue);
  }
  .photos__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin-top: 8px;
  }
  .photos__list:empty {
    display: none;
  }
  .photos__list :global(li) {
    position: relative;
  }
  .photos__list :global(img) {
    width: 56px;
    height: 56px;
    object-fit: cover;
    border-radius: 8px;
  }
  .photos__list :global(button) {
    position: absolute;
    top: -8px;
    right: -8px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 2px solid #fff;
    background: var(--ah-ink);
    color: #fff;
    font-size: 15px;
    line-height: 1;
  }

  .consent {
    margin-top: 14px;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .btn--submit[aria-busy='true'] {
    opacity: 0.75;
    pointer-events: none;
  }

  .quote-success {
    display: grid;
    gap: 14px;
    justify-items: center;
    text-align: center;
  }
  .quote-success[hidden] {
    display: none;
  }
  .quote-success:focus {
    outline: none;
  }
  .quote-success :global(.btn) {
    white-space: normal;
    text-align: center;
  }
  .quote-success__icon {
    color: var(--ok);
  }
  .quote-success__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-style: italic;
    text-transform: uppercase;
    font-size: 2rem;
  }
  .quote-success__msg {
    font-size: 1.125rem;
    max-width: 34ch;
  }
</style>

<script>
  import '../../scripts/quote-form';
</script>
