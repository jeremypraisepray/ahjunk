---
import Icon from './Icon.astro';
import { business } from '../data/business';
interface Props { quoteHref: string }
const { quoteHref } = Astro.props;
---
<nav class="action-bar" aria-label="Quick actions" data-action-bar>
  <a href={business.phone.tel} data-track="click_call" data-track-loc="sticky_bar"><Icon name="Phone" />Call</a>
  <a href={`${business.phone.sms}?&body=${encodeURIComponent(business.smsBody)}`} data-track="click_text" data-track-loc="sticky_bar"><Icon name="Camera" />Text a Photo</a>
  <a class="action-bar__quote" href={quoteHref} data-quote-open><Icon name="Zap" />Free Quote</a>
</nav>
<style>
  .action-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 60;
    display: grid;
    grid-template-columns: 1fr 1.25fr 1.15fr;
    gap: 6px;
    padding: 8px 8px calc(8px + env(safe-area-inset-bottom));
    background: var(--ah-ink);
    box-shadow: 0 -6px 20px rgb(8 13 22 / 0.25);
    transition: transform 0.25s ease;
    --focus: var(--blue-on-dark);
  }
  .action-bar.is-hidden {
    transform: translateY(110%);
  }
  .action-bar a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 48px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.9375rem;
    color: #fff;
    text-decoration: none;
    background: rgb(255 255 255 / 0.08);
    white-space: nowrap;
  }
  .action-bar a :global(svg) {
    width: 18px;
    height: 18px;
  }
  .action-bar a:active {
    transform: scale(0.97);
  }
  .action-bar .action-bar__quote {
    background: var(--btn);
  }
  @media (min-width: 768px) {
    .action-bar {
      display: none;
    }
  }
</style>
