---
import Icon from './Icon.astro';
import { business } from '../data/business';
interface Props { quoteHref?: string; heading?: string }
const { quoteHref = '#quote', heading = 'Ready to reclaim your space?' } = Astro.props;
---
<section class="cta on-dark" aria-labelledby="cta-h">
  <div class="wrap cta__in">
    <h2 class="h2" id="cta-h">{heading}</h2>
    <p class="cta__sub">Same-day &amp; next-day slots available — 7 days a week across Greater Houston.</p>
    <div class="cta__btns">
      <a class="btn btn--white btn--lg" href={quoteHref} data-quote-open><Icon name="Zap" />Get Free Quote</a>
      <a class="btn btn--ghost-light btn--lg" href={business.phone.tel} data-track="click_call" data-track-loc="cta_band"><Icon name="Phone" />Call {business.phone.display}</a>
    </div>
  </div>
</section>
<style>
  .cta {
    background: var(--ah-gradient);
    padding-block: clamp(48px, 7vw, 88px);
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(-60deg, rgb(255 255 255 / 0.04) 0 14px, transparent 14px 40px), rgb(8 13 22 / 0.22);
  }
  .cta__in {
    position: relative;
    display: grid;
    gap: 16px;
    justify-items: center;
  }
  .cta__sub {
    font-size: 1.125rem;
    font-weight: 500;
  }
  .cta__btns {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 8px;
  }
  @media (max-width: 480px) {
    .cta__btns {
      display: grid;
      width: 100%;
    }
  }
</style>
