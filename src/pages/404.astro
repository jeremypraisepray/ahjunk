---
import Base from '../layouts/Base.astro';
import { business } from '../data/business';
---
<Base title={`Page not found | ${business.name}`} description="That page got hauled away." noindex>
  <section class="nf">
    <div class="wrap">
      <p class="display nf__code">404</p>
      <h1 class="h2">This page got hauled away.</h1>
      <p class="lead">Let’s get you where you’re going.</p>
      <p class="nf__btns"><a class="btn btn--lg" href="/#quote">Get a free quote</a> <a class="btn btn--ghost btn--lg" href="/">Home</a></p>
    </div>
  </section>
</Base>
<style>
  .nf {
    padding-block: 80px;
    text-align: center;
  }
  .nf .lead {
    margin: 12px auto 24px;
  }
  .nf__code {
    font-size: 6rem;
    line-height: 1;
    color: var(--orange-text);
  }
  .nf__btns {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
