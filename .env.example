# ─────────────────────────────────────────────────────────────────────────────
# A&H Junk Removal — environment variables
# Copy to .env.local (gitignored) for local dev. In production set the same keys
# in the hosting dashboard (Vercel → Project → Settings → Environment Variables).
# Everything here is SERVER-SIDE ONLY unless it starts with PUBLIC_.
# Never prefix GHL / Resend / Blob keys with PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# How /api/quote delivers leads: api | webhook | mock
#   api     → GoHighLevel API v2 (contact upsert + note + opportunity)
#   webhook → GHL Workflow "Inbound Webhook" trigger (flat JSON)
#   mock    → logs a masked summary only (default when no GHL creds are set)
GHL_MODE=

# GoHighLevel API v2 (sub-account level Private Integration Token)
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
GHL_API_VERSION=2021-07-28
GHL_PIPELINE_ID=              # "Website Leads" pipeline
GHL_STAGE_NEW_LEAD_ID=        # first stage of that pipeline

# Contact custom field IDs (run `npm run ghl:discover` to print these)
GHL_CF_ITEMS=
GHL_CF_LOAD_SIZE=
GHL_CF_TIMING=
GHL_CF_PREFERRED_CONTACT=
GHL_CF_NOTES=
GHL_CF_PHOTOS=
GHL_CF_UTM_SOURCE=
GHL_CF_UTM_MEDIUM=
GHL_CF_UTM_CAMPAIGN=
GHL_CF_GCLID=
GHL_CF_LANDING_PAGE=
GHL_CF_SMS_CONSENT=           # stored as "yes | 2026-10-29T23:25:00-05:00 | /"

# Alternative to the API: GHL Workflow inbound webhook URL (GHL_MODE=webhook)
GHL_INBOUND_WEBHOOK_URL=

# Fallback email (only used if GHL delivery fails)
FALLBACK_EMAIL_TO=ahernandezjunkremoval@gmail.com
FALLBACK_EMAIL_FROM=          # verified Resend sender, e.g. "A&H Website <leads@yourdomain.com>"
RESEND_API_KEY=

# Photo storage (Vercel Blob read/write token)
BLOB_READ_WRITE_TOKEN=

# Public, safe to expose — analytics (leave blank to disable)
PUBLIC_GA4_ID=                # e.g. G-XXXXXXXXXX
PUBLIC_GADS_ID=               # e.g. AW-123456789
PUBLIC_GADS_LEAD_LABEL=       # conversion label for quote submits
PUBLIC_GADS_CALL_LABEL=       # conversion label for tel:/sms: clicks
